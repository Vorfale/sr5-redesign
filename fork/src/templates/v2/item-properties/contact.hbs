{{#if (or item.system.linkedActor (not (empty item.system.type)))}}
    <label data-prop="kind">
        {{#if item.system.linkedActor}}
            <a data-uuid="{{item.system.linkedActor}}" data-action="openUuid">
                <i class="far fa-user-tag"></i>
            </a>
        {{else}}
            <i class="far fa-user-tag"></i>
        {{/if}}
        {{item.system.type}}
    </label>
{{/if}}
<label class="prop-dup" data-prop="stat"><i class="prop-icon fas fa-network-wired" aria-hidden="true"></i>{{localize "SR5.Contact.Connection"}}&nbsp;{{item.system.connection}}</label>
<label class="prop-dup" data-prop="stat"><i class="prop-icon fas fa-handshake" aria-hidden="true"></i>{{localize "SR5.Contact.Loyalty"}}&nbsp;{{item.system.loyalty}}</label>
{{#if item.system.blackmail}}
    <label data-prop="kind"><i class="prop-icon fas fa-user-secret" aria-hidden="true"></i>{{localize "SR5.Contact.Blackmail"}}</label>
{{/if}}
{{#if item.system.family}}
    <label data-prop="kind"><i class="prop-icon fas fa-people-roof" aria-hidden="true"></i>{{localize "SR5.Contact.Family"}}</label>
{{/if}}
