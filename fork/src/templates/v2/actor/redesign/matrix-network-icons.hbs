{{!-- network icons (after tabs/matrix/network-icons.hbs) with a note when the list is empty that says why,
      by the Shadowrun rules and the way the system fills the list. --}}
<section class="tab hide-overflow{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="fill-container">
        {{> 'systems/shadowrun5e/dist/templates/v2/list-items/network_icon/header.hbs'
            label='SR5.Labels.ActorSheet.Icons'
            type='network_icon'
            cssClass="header-for-scrollable"
        }}
        <div id="network-icons-scroll" class="scrollable">
        {{!-- Show main icons (personas) visible to this actor --}}
        {{#each @root.matrixTargets}}
            {{> 'systems/shadowrun5e/dist/templates/v2/list-items/network_icon/item.hbs' item=this}}
            {{! -- Overview of icons connected to the main icon (devices of persona) -- }}
            {{#each this.icons}}
                {{> 'systems/shadowrun5e/dist/templates/v2/list-items/network_icon/item.hbs' item=this cssClass="list-item-subcategory"}}
            {{/each}}
        {{else}}
            {{!-- empty: why, by Shadowrun rules and the way the system fills this list --}}
            <p class="empty-note matrix-empty">{{localize "SR5.Redesign.MatrixEmpty.icons"}}</p>
        {{/each}}
        </div>
    </div>
</section>
