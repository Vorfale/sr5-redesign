{{!-- compilations (after tabs/matrix/compilations.hbs) with a note when the list is empty that says why,
      by the Shadowrun rules and the way the system fills the list. --}}
<section class="tab hide-overflow{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="fill-container">
        {{> 'systems/shadowrun5e/dist/templates/v2/list-items/call_in_action/header.hbs'
            label='SR5.Labels.ActorSheet.Compilations'
            type='call_in_action'
            actor_type='sprite'
            cssClass="header-for-scrollable" }}
        <div id="compilations-scroll" class="scrollable">
        {{#each itemType.compilation}}
            {{> "systems/shadowrun5e/dist/templates/v2/list-items/call_in_action/item.hbs"
                item=this }}
        {{else}}
            {{!-- empty: why, by Shadowrun rules and the way the system fills this list --}}
            <p class="empty-note matrix-empty">{{#if @root.emerged}}{{localize "SR5.Redesign.MatrixEmpty.compilations"}}{{else}}{{localize "SR5.Redesign.MatrixEmpty.compilationsNotEmerged"}}{{/if}}</p>
        {{/each}}
        </div>
    </div>
</section>
