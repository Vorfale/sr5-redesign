{{!-- "Details" tab: skills with dice pools on the left; qualities and knowledge/languages on the right.
      Limits moved to the header, reputation to the footer, walk/run to the sidebar (the sprinting bonus to the
      Run card there, set on the Configuration tab). With nothing for the right column
      (play mode, no knowledge or languages, no qualities or the player hides them) the skills take the whole width. --}}
<section class="tab sr-details{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="col-2{{#if detailsSingleColumn}} single{{/if}}">
        <div class="left">
            <div class="card skills">
                {{> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/skills.hbs' }}
            </div>
        </div>
        <div class="right">
            {{#if (or @root.isEditMode hasLanguageKnowledgeSkills)}}
                <div class="card knowledge">
                    {{> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/knowledge.hbs' }}
                </div>
            {{/if}}

            {{!-- the qualities: each player's choice (Settings, "Show qualities on the Details tab"); Bio keeps them --}}
            {{#if showQualities}}
            <section class="pills-group{{#unless (or @root.isEditMode qualities.positive.length)}} empty{{/unless}}" aria-labelledby="{{rootId}}-positive">
                <h3 class="icon" id="{{rootId}}-positive"><i class="fas fa-circle-plus" aria-hidden="true"></i><span>{{localize "SR5.Redesign.PositiveQualities"}}</span></h3>
                <ul class="pills unlist">
                    {{#each qualities.positive}}
                        <li class="pill positive" data-item-id="{{this.id}}" data-uuid="{{this.uuid}}" data-context-menu="item">
                            <button type="button" class="unbutton label" data-action="editItem" data-tooltip="{{this.name}}">{{this.name}}</button>
                        </li>
                    {{else}}
                        <li class="empty-row">{{#if @root.isEditMode}}{{localize "SR5.Redesign.EmptyQualitiesEdit"}}{{else}}{{localize "SR5.Redesign.EmptyTable"}}{{/if}}</li>
                    {{/each}}
                </ul>
            </section>
            <section class="pills-group{{#unless (or @root.isEditMode qualities.negative.length)}} empty{{/unless}}" aria-labelledby="{{rootId}}-negative">
                <h3 class="icon" id="{{rootId}}-negative"><i class="fas fa-circle-minus" aria-hidden="true"></i><span>{{localize "SR5.Redesign.NegativeQualities"}}</span></h3>
                <ul class="pills unlist">
                    {{#each qualities.negative}}
                        <li class="pill negative" data-item-id="{{this.id}}" data-uuid="{{this.uuid}}" data-context-menu="item">
                            <button type="button" class="unbutton label" data-action="editItem" data-tooltip="{{this.name}}">{{this.name}}</button>
                        </li>
                    {{else}}
                        <li class="empty-row">{{#if @root.isEditMode}}{{localize "SR5.Redesign.EmptyQualitiesEdit"}}{{else}}{{localize "SR5.Redesign.EmptyTable"}}{{/if}}</li>
                    {{/each}}
                </ul>
            </section>
            {{/if}}
        </div>
    </div>
</section>
