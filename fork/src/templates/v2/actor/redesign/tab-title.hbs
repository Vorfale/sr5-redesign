{{!-- Section plaque at the top of a tab (icon + name of the tab), like the "Quick Rolls" plaque in the sidebar.
      Called as a block, the block's content (e.g. the inventory picker) sits on the right of the plaque, above the
      same line. --}}
{{#if @partial-block}}
<div class="tab-title-row">
    <h2 class="plaque tab-title"><span class="plaque-tab"><i class="{{tab.icon}}" aria-hidden="true"></i><span>{{localize tab.label}}</span></span></h2>
    <div class="tab-title-controls">{{> @partial-block }}</div>
</div>
{{else}}
<h2 class="plaque tab-title"><span class="plaque-tab"><i class="{{tab.icon}}" aria-hidden="true"></i><span>{{localize tab.label}}</span></span></h2>
{{/if}}
