{{!-- Inventory: top row with a nuyen card and container tiles, then the regular SR5 inventory sections as cards.
      In play mode empty sections are left out and a character without any inventory items gets the tab's empty
      state, like the other tabs; edit mode draws every section, an empty one with its empty row. --}}
<section class="tab sr-inventory{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{#> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/tab-title.hbs' }}
        <div class="inventory-controls">
            {{!-- the select's id is the base sheet's listener selector (scoped to the sheet); the label goes by an id
                  of this sheet, as a for="select-inventory" would find the first open sheet's select --}}
            <label id="{{@root.rootId}}-inventory-label">{{localize 'SR5.Labels.Inventory.OpenInventory'}}</label>
            <span class="plaque-select secondary">
                <select id="select-inventory" class="sr5-select" aria-labelledby="{{@root.rootId}}-inventory-label">
                    {{#each inventories as |inventory name|}}
                        <option value="{{inventory.name}}" {{#ife ../selectedInventory inventory.name}}selected="selected"{{/ife}}>{{localize inventory.label}}</option>
                    {{/each}}
                </select>
                <i class="fas fa-caret-down dropdown-caret" aria-hidden="true"></i>
            </span>
            {{#if @root.isEditMode}}
                {{#if (inventoryCanRename selectedInventory)}}
                    <button type="button" class="unbutton" data-action="renameInventory" data-inventory="{{selectedInventory}}"
                            data-tooltip="SR5.Redesign.RenameInventory" aria-label="{{localize 'SR5.Redesign.RenameInventory'}}"><i class="fas fa-pen-to-square" aria-hidden="true"></i></button>
                {{/if}}
                {{#if (inventoryCanRemove selectedInventory)}}
                    <button type="button" class="unbutton" data-action="removeInventory" data-inventory="{{selectedInventory}}"
                            data-tooltip="SR5.Redesign.RemoveInventory" aria-label="{{localize 'SR5.Redesign.RemoveInventory'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                {{/if}}
                <button type="button" class="unbutton" data-action="createInventory" data-tooltip="SR5.Labels.ActorSheet.CreateInventory"
                        aria-label="{{localize 'SR5.Labels.ActorSheet.CreateInventory'}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
            {{/if}}
        </div>
    {{/'systems/shadowrun5e/dist/templates/v2/actor/redesign/tab-title.hbs'}}
{{#if tabEmpty}}
    {{> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/empty-tab.hbs' }}
{{else}}
    {{> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/list-controls.hbs' }}
    {{#if (and containersEnabled (or containers.length @root.isEditMode))}}
    <section class="top" aria-labelledby="{{rootId}}-containers">
        <h3 class="plaque" id="{{rootId}}-containers"><span class="plaque-tab"><i class="fas fa-box-open" aria-hidden="true"></i><span>{{localize "TYPES.Item.container"}}</span></span></h3>
        <ul class="containers unlist">
            {{#each containers}}
                <li class="container" data-item-id="{{this.item.id}}" data-uuid="{{this.item.uuid}}" data-context-menu="item">
                    <button type="button" class="container-tile draggable" data-action="editItem" data-item-id="{{this.item.id}}"
                            data-tooltip="{{this.item.name}}" aria-label="{{this.item.name}} ({{this.count}})">
                        <img src="{{this.item.img}}" alt="">
                        <span class="count" aria-hidden="true">{{this.count}}</span>
                    </button>
                </li>
            {{/each}}
            {{#if @root.isEditMode}}
                <li class="container add">
                    <button type="button" class="container-tile" data-action="addItem" data-item-type="container"
                            data-tooltip="SR5.Redesign.AddContainer" aria-label="{{localize 'SR5.Redesign.AddContainer'}}">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                    </button>
                </li>
            {{/if}}
        </ul>
    </section>
    {{/if}}

    <div class="items-sections">
        {{#each inventory.types as |section type|}}
            {{#if (or @root.isEditMode section.items.length)}}
                {{!-- containers are tiles above; a character's cyberware / bioware have their own Augmentations tab (a
                      vehicle has none: an anthro drone's ware lists here) --}}
                {{#unless (or (eq type 'container') (and (not @root.isVehicle) (or (eq type 'cyberware') (eq type 'bioware'))))}}
                <div class="items-section card{{#unless (or section.isOpen @root.isEditMode)}} collapsed{{/unless}}" data-type="{{type}}">
                    {{> (concat "systems/shadowrun5e/dist/templates/v2/list-items/" type "/header.hbs")
                        label=section.label isOpen=section.isOpen type=type rootId=@root.rootId }}
                    {{!-- rendered when collapsed too (CSS hides them), so the list search finds them --}}
                    {{#each section.items}}
                        {{> (concat "systems/shadowrun5e/dist/templates/v2/list-items/" type "/item.hbs")
                            item=this rootId=@root.rootId }}
                    {{else}}
                        {{> 'systems/shadowrun5e/dist/templates/v2/actor/redesign/empty-row.hbs' }}
                    {{/each}}
                </div>
                {{/unless}}
            {{/if}}
        {{/each}}
    </div>
{{/if}}
</section>
