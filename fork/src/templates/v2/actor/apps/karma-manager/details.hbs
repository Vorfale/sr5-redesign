<div class="fill-container">
    <div class="input-row">
        <div class="manager-value">
            <label>{{localize "SR5.KarmaManager.StartingKarma"}}</label>
            <div>
                <span>
                    <label class="label" data-tooltip="SR5.KarmaManager.CurrentKarma">{{karma}}</label>&nbsp;
                    <label class="label" data-tooltip="SR5.KarmaManager.CareerKarma">(&nbsp;{{careerKarma}}&nbsp;)</label>
                </span>
            </div>
        </div>
        <label class="manager-operator" aria-hidden="true"><i class="fas fa-plus"></i></label>
        <div class="input-col">
            <div class="mod-button-container">
                <button type="button" class="mod-step" name="step-increaseKarma-1" data-action="increaseKarma" data-amount="1">+1</button>
                <button type="button" class="mod-step" name="step-increaseKarma-5" data-action="increaseKarma" data-amount="5">+5</button>
            </div>
            <div>
                <input class="short midd center mod-input" type="number" name="incoming-karma" value={{karmaModifier}}
                       aria-label="{{localize 'SR5.KarmaManager.Title'}}" />
            </div>
            <div class="mod-button-container">
                <button type="button" class="mod-step" name="step-reduceKarma-1" data-action="reduceKarma" data-amount="1">−1</button>
                <button type="button" class="mod-step" name="step-reduceKarma-5" data-action="reduceKarma" data-amount="5">−5</button>
            </div>
        </div>
        <label class="manager-operator" aria-hidden="true"><i class="fas fa-equals"></i></label>
        <div class="manager-value">
            <label>{{localize "SR5.KarmaManager.FinalKarma"}}</label>
            <div>
                <span>
                    <label class="label {{#if (gt karmaModifier 0)}} positive {{else if (lt karmaModifier 0)}} negative {{/if}}"
                        data-tooltip="SR5.KarmaManager.FinalCurrentKarma">{{modifiedKarma}}</label>&nbsp;
                    <label class="label {{#if (gt karmaModifier 0)}} positive {{/if}}"
                           data-tooltip="SR5.KarmaManager.FinalCareerKarma">(&nbsp;{{modifiedCareerKarma}}&nbsp;)</label>
                </span>
            </div>
        </div>
    </div>
</div>
